{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/.local/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PSVR2_BUILD_TOOLS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/.local/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "sanitize",
      "displayName": "ASan and UBSan",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/.local/build-sanitize",
      "cacheVariables": {
        "PSVR2_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "ci",
      "displayName": "CI warnings-as-errors",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/.local/build-ci",
      "cacheVariables": {
        "PSVR2_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug"},
    {"name": "release", "configurePreset": "release"},
    {"name": "sanitize", "configurePreset": "sanitize"},
    {"name": "ci", "configurePreset": "ci"}
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": {"outputOnFailure": true}
    }
  ]
}
