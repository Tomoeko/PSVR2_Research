# PSVR2 maximal static configuration overrides for BusyBox 1.29.0.
#
# The build starts from upstream allyesconfig, applies these target-specific
# choices, and runs oldconfig so Kconfig resolves every dependency.

CONFIG_STATIC=y
# CONFIG_NOMMU is not set

# Build both shells. Use ash for the sh/bash aliases and retain hush as an
# independently invokable applet.
CONFIG_SH_IS_ASH=y
# CONFIG_SH_IS_HUSH is not set
# CONFIG_SH_IS_NONE is not set
CONFIG_BASH_IS_ASH=y
# CONFIG_BASH_IS_HUSH is not set
# CONFIG_BASH_IS_NONE is not set
CONFIG_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_BASH_COMPAT=y
CONFIG_ASH_BASH_SOURCE_CURDIR=y
CONFIG_ASH_BASH_NOT_FOUND_HOOK=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_RANDOM_SUPPORT=y
CONFIG_ASH_EXPAND_PRMT=y
CONFIG_ASH_IDLE_TIMEOUT=y
CONFIG_ASH_MAIL=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_HELP=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_HUSH=y

# External-library integrations unavailable in the self-contained musl target.
# CONFIG_PAM is not set
# CONFIG_SELINUX is not set
# CONFIG_FEATURE_MOUNT_NFS is not set
# CONFIG_FEATURE_INETD_RPC is not set

# These allyesconfig paths rely on glibc regex internals or Linux UAPI
# definitions not provided by Zig's portable musl target.
# CONFIG_EXTRA_COMPAT is not set
# CONFIG_FEATURE_VI_REGEX_SEARCH is not set
# CONFIG_TC is not set

# Host-distribution and developer-only modes are not target functionality.
# CONFIG_FEDORA_COMPAT is not set
# CONFIG_DEBUG is not set
# CONFIG_DEBUG_PESSIMIZE is not set
# CONFIG_DEBUG_SANITIZE is not set
# CONFIG_UNIT_TEST is not set
# CONFIG_WERROR is not set
